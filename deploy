#!/bin/bash

set -Eeuo pipefail

trap 'echo "Error on line $LINENO: $BASH_COMMAND" >&2' ERR

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly CONFIG_DIR="$HOME/.config"
readonly BIN_DIR="$HOME/.local/bin"
readonly PACMAN_CONF="/etc/pacman.conf"

info() {
  echo "==> $*"
}

warn() {
  echo "WARNING: $*" >&2
}

error() {
  echo "ERROR: $*" >&2
  exit 1
}

require_command() {
  local command="$1"

  if ! command -v "$command" >/dev/null 2>&1; then
    error "Required command not found: $command"
  fi
}

load_dependencies() {
  local file="$1"
  local -n deps="$2"

  deps=()

  [[ -f "$file" ]] || return 0

  mapfile -t deps < <(
    sed \
      -e 's/#.*//' \
      -e '/^[[:space:]]*$/d' \
      -e 's/^[[:space:]]*//' \
      -e 's/[[:space:]]*$//' \
      "$file"
  )
}

enable_multilib() {
  info "Enabling multilib repository"

  if grep -qE '^[[:space:]]*\[multilib\][[:space:]]*$' "$PACMAN_CONF"; then
    info "Multilib is already enabled."
    return
  fi

  if ! grep -qE '^[[:space:]]*#\[multilib\][[:space:]]*$' "$PACMAN_CONF"; then
    error "Could not find the commented multilib section in $PACMAN_CONF"
  fi

  sudo sed -i \
    -e 's/^[[:space:]]*#\[multilib\][[:space:]]*$/[multilib]/' \
    -e 's/^[[:space:]]*#Include = \/etc\/pacman\.d\/mirrorlist$/Include = \/etc\/pacman.d\/mirrorlist/' \
    "$PACMAN_CONF"

  info "Multilib enabled."
}

configure_reflector() {
  info "Installing and enabling reflector"

  sudo pacman -S --needed --noconfirm reflector
  sudo systemctl enable --now reflector.service
}

update_system() {
  info "Updating system packages"

  sudo pacman -Syu --noconfirm
}

# Runs in a subshell so the EXIT trap is scoped to this function:
# the temp dir is removed on success and on failure, and the trap
# never leaks into the rest of the script.
install_yay() (
  info "Installing yay"

  sudo pacman -S --needed --noconfirm git base-devel

  local build_dir
  build_dir="$(mktemp -d)"
  trap 'rm -rf "$build_dir"' EXIT

  git clone https://aur.archlinux.org/yay.git "$build_dir/yay"

  cd "$build_dir/yay"
  makepkg -si --noconfirm

  info "yay installed."
)

update_aur_helper() {
  info "Updating AUR packages"

  yay -Syu --noconfirm
}

install_pacman_dependencies() {
  local dependency_file="$SCRIPT_DIR/dependencies/pacman.txt"
  local dependencies=()

  info "Installing official repository packages"

  load_dependencies "$dependency_file" dependencies

  if ((${#dependencies[@]} == 0)); then
    info "No pacman dependencies to install."
    return
  fi

  sudo pacman -S --needed --noconfirm "${dependencies[@]}"
}

install_aur_dependencies() {
  local dependency_file="$SCRIPT_DIR/dependencies/aur.txt"
  local dependencies=()

  info "Installing AUR packages"

  load_dependencies "$dependency_file" dependencies

  if ((${#dependencies[@]} == 0)); then
    info "No AUR dependencies to install."
    return
  fi

  yay -S --needed --noconfirm "${dependencies[@]}"
}

install_packages() {
  install_pacman_dependencies

  if ! command -v yay >/dev/null 2>&1; then
    install_yay
  fi

  update_aur_helper
  install_aur_dependencies
}

# Symlink $1 to $2, backing up anything already at $2 that isn't that link.
link_path() {
  local source="$1"
  local target="$2"
  local name
  local backup

  name="$(basename "$target")"

  if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source" ]]; then
    info "Already linked $name"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    backup="$target.backup.$(date +%Y%m%d%H%M%S%N)"
    mv "$target" "$backup"
    info "Backed up $name to $backup"
  fi

  ln -s "$source" "$target"
  info "Linked $name"
}

create_config_symlinks() {
  local config_dir

  info "Creating configuration symlinks"

  mkdir -p "$CONFIG_DIR"

  link_path "$SCRIPT_DIR/.zshrc" "$HOME/.zshrc"

  shopt -s nullglob

  for config_dir in "$SCRIPT_DIR"/config/*/; do
    link_path "$config_dir" "$CONFIG_DIR/$(basename "$config_dir")"
  done

  shopt -u nullglob
}

create_bin_symlinks() {
  local script

  info "Linking scripts from bin/ into $BIN_DIR"

  if [[ ! -d "$SCRIPT_DIR/bin" ]]; then
    info "No bin directory found; skipping."
    return
  fi

  mkdir -p "$BIN_DIR"

  shopt -s nullglob

  for script in "$SCRIPT_DIR"/bin/*; do
    # Only regular files; skip subdirectories
    [[ -f "$script" ]] || continue

    chmod +x "$script"
    link_path "$script" "$BIN_DIR/$(basename "$script")"
  done

  shopt -u nullglob

  if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
    warn "$BIN_DIR is not in your PATH. Add this to your .zshrc:"
    warn "  export PATH=\"\$HOME/.local/bin:\$PATH\""
  fi
}

make_waybar_script_executable() {
  local waybar_script="$CONFIG_DIR/waybar/waybar.sh"

  if [[ -f "$waybar_script" ]]; then
    info "Making Waybar script executable"
    chmod +x "$waybar_script"
  fi
}

change_default_shell() {
  local zsh_path
  local current_shell

  info "Configuring default shell"

  if ! command -v zsh >/dev/null 2>&1; then
    info "zsh is not installed; skipping shell configuration."
    return
  fi

  # chsh only accepts paths listed in /etc/shells, so pick zsh from there
  # instead of from PATH (which may resolve to e.g. /usr/sbin/zsh).
  zsh_path="$(grep -m1 -E '^/usr/bin/zsh$' /etc/shells || grep -m1 -E '^/.*/zsh$' /etc/shells || true)"

  if [[ -z "$zsh_path" ]]; then
    error "zsh is installed but not listed in /etc/shells."
  fi

  current_shell="$(getent passwd "$USER" | cut -d: -f7)"

  if [[ "$(readlink -f "$current_shell")" == "$(readlink -f "$zsh_path")" ]]; then
    info "zsh is already the default shell."
    return
  fi

  chsh -s "$zsh_path"

  info "Default shell changed to $zsh_path."
}

validate_environment() {
  info "Checking environment"

  if [[ "$EUID" -eq 0 ]]; then
    error "Do not run this script as root."
  fi

  require_command sudo
  require_command pacman
  require_command git

  sudo -v
}

# Returns success if the machine has a system battery (laptop).
# Peripheral batteries (wireless mice, headsets) also show up as type
# "Battery" but have scope "Device", so those are ignored.
has_battery() {
  local supply
  local scope

  for supply in /sys/class/power_supply/*; do
    [[ -r "$supply/type" ]] || continue
    [[ "$(<"$supply/type")" == "Battery" ]] || continue

    scope=""
    [[ -r "$supply/scope" ]] && scope="$(<"$supply/scope")"
    [[ "$scope" == "Device" ]] && continue

    return 0
  done

  return 1
}

setup_battery_notification() {
  local unit_dir="$CONFIG_DIR/systemd/user"
  local unit

  info "Setup battery notification"

  if ! has_battery; then
    info "No battery detected; skipping battery notification."
    return
  fi

  mkdir -p "$unit_dir"

  for unit in battery-notification.service battery-notification.timer; do
    link_path "$SCRIPT_DIR/services/$unit" "$unit_dir/$unit"
  done

  systemctl --user daemon-reload
  systemctl --user enable --now battery-notification.timer
}

setup_services() {
  info "Enabling services"

  sudo systemctl enable ly@tty2.service
}

main() {
  info "Starting Arch Linux setup"

  validate_environment

  create_config_symlinks
  create_bin_symlinks

  enable_multilib
  configure_reflector

  update_system
  install_packages

  change_default_shell
  make_waybar_script_executable
  setup_services
  setup_battery_notification

  info "Arch Linux setup completed successfully."
}

main "$@"
