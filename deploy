#!/bin/bash

set -Eeuo pipefail
trap 'echo "Error on line $LINENO: $BASH_COMMAND" >&2' ERR

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config"

# replace line endings with a space (for use in package managers)
function fileToList {
  echo $(cat $1 | sed ':a;N;$!ba;s/\n/ /g')
}

enable_multilib() {
  local pacman_conf="/etc/pacman.conf"

  if grep -qE '^\[multilib\]' "$pacman_conf"; then
    echo "Multilib is already enabled."
    return 0
  fi

  if ! grep -qE '^#\[multilib\]' "$pacman_conf"; then
    echo "Could not find the commented multilib section in $pacman_conf" >&2
    return 1
  fi

  sudo sed -i \
    -e 's/^#\[multilib\]/[multilib]/' \
    -e 's/^#Include = \/etc\/pacman\.d\/mirrorlist/Include = \/etc\/pacman.d\/mirrorlist/' \
    "$pacman_conf"

  echo "Multilib enabled."
}

install_yay() {
  sudo pacman -S --needed --noconfirm git base-devel
  local tmpdir
  tmpdir=$(mktemp -d)

  git clone https://aur.archlinux.org/yay.git "$tmpdir/yay"
  (
    cd "$tmpdir/yay" &&
      makepkg -si --noconfirm
  )

  rm -rf "$tmpdir"
}

# create symlinks

ln -sfn $SCRIPT_DIR/.zshrc ~/.zshrc

mkdir -p ~/.config
# symlinks for .config dirs
for dir in "$SCRIPT_DIR"/config/*/; do
  ln -sfn "$dir" "$CONFIG_DIR/$(basename "$dir")"
done

# create mirrorlist
sudo pacman -S reflector --noconfirm
sudo systemctl enable reflector.service

# enable Multilib
enable_multilib

sudo pacman -Syu --noconfirm

# install requirements
dep=$(fileToList dependencies/pacman.txt)
echo $dep
sudo pacman --noconfirm -S $dep

if ! command -v yay >/dev/null 2>&1; then
  install_yay
fi

yay -Syu --noconfirm

aurDep=$(fileToList dependencies/aur.txt)
echo $aurDep
yay -S $aurDep --noconfirm

# Enable ly login manager
sudo systemctl enable ly.service

#change shell to zsh
if command -v zsh >/dev/null 2>&1; then
  chsh -s "$(command -v zsh)"
fi

# make waybar launch file executable
if [[ -f "$CONFIG_DIR/waybar/waybar.sh" ]]; then
  chmod +x "$CONFIG_DIR/waybar/waybar.sh"
fi

exit 0
