#!/bin/bash

# Battery threshold for notifications (change as needed)
LOW_THRESHOLD=15

for battery in /sys/class/power_supply/BAT*; do
  [[ -r "$battery/capacity" ]] || continue

  BATTERY_STATUS=$(<"$battery/status")
  BATTERY_CAPACITY=$(<"$battery/capacity")

  # Only warn while running on battery
  [[ "$BATTERY_STATUS" == "Discharging" ]] || continue

  if [ "$BATTERY_CAPACITY" -le "$LOW_THRESHOLD" ]; then
    notify-send "Battery low" "Battery is at ${BATTERY_CAPACITY}%" -u critical -i "battery-caution"
  fi
done
